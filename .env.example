# ---------------------------------------------------------------------------
# 한줄 (hanjul) — environment variables
# Copy this file to .env and fill in your own keys.
#   cp .env.example .env
# NEVER commit .env.
# ---------------------------------------------------------------------------

# NEIS Open API key — https://open.neis.go.kr
NEIS_KEY=your_neis_key_here

# OpenAI API key (optional, used for AI assist features)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Demo defaults (optional)
DEMO_ATPT_OFCDC_SC_CODE=J10
DEMO_SD_SCHUL_CODE=7530207
DEMO_SCHOOL_NAME=진성고등학교
DEMO_REGION=경기도 광명시
