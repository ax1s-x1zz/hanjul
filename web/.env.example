# ---------------------------------------------------------------------------
# 한줄 web (Next.js) — copy to .env.local
# ---------------------------------------------------------------------------

# Supabase (optional for the local demo; required for real accounts/DB)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NEIS Open API (server-only). Without it, /today shows a sample timetable
# labeled "샘플". With it, the app loads the real timetable for the selected date.
NEIS_KEY=
NEIS_OFFICE_CODE=J10
NEIS_SCHOOL_CODE=7530207

# AI (server-only; not used by the local demo)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
